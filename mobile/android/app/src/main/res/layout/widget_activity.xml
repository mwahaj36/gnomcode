<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity" android:textColor="#E6E8EE" android:textSize="14sp" android:textStyle="bold" />
    <ImageView android:id="@+id/heatmap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scaleType="fitStart" android:adjustViewBounds="true" android:contentDescription="Token activity heatmap" />
    <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#E6E8EE" android:textSize="13sp" />
    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#9AA1B2" android:textSize="11sp" />
</LinearLayout>
