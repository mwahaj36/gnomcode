<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Limits" android:textColor="#E6E8EE" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/name0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6E8EE" android:textSize="13sp" />
        <ProgressBar android:id="@+id/bar0" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/limit_bar" />
        <TextView android:id="@+id/detail0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9AA1B2" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/name1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6E8EE" android:textSize="13sp" />
        <ProgressBar android:id="@+id/bar1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/limit_bar" />
        <TextView android:id="@+id/detail1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9AA1B2" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/name2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6E8EE" android:textSize="13sp" />
        <ProgressBar android:id="@+id/bar2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/limit_bar" />
        <TextView android:id="@+id/detail2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9AA1B2" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#9AA1B2" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#9AA1B2" android:textSize="11sp" />
</LinearLayout>
