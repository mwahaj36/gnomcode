target/
apps/
npm/
# The whole crates tree is 3 MB of text and goes up as-is: re-including only
# crates/daemon/src/console-react.js from an excluded parent did not survive the upload,
# and the web prebuild fails without that bundle.
fixtures/
workers/
/docs/
.agents/
.github/
.tmp/
**/node_modules/
**/.next/
**/.env*

# Installers are served from this repository's GitHub release; web/app/downloads/[asset] redirects there.
web/public/downloads/*.exe
web/public/downloads/*.zip

# Keep maintainer records and local visual-review output off the deployment.
localdocs/
.claude/
.impeccable/
web/.next-review/
web/test-results/
web/web-test-results/
test-results/

# Local launch-video exports are not website deployment inputs.
brag-output-*/
