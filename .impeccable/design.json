      "css": ".ds-label{display:block;font-family:var(--sp-font-sans,system-ui,sans-serif);font-size:13px;line-height:1.4;color:var(--sp-text-2);margin-bottom:8px}.ds-field{font-family:var(--sp-font-sans,system-ui,sans-serif);font-size:13px;line-height:1.4;min-height:44px;padding:10px 12px;background:var(--sp-bg);color:var(--sp-text);border:1px solid var(--sp-border);border-radius:var(--sp-control-radius,6px)}.ds-field:hover{border-color:var(--sp-border-strong)}.ds-field:focus-visible{outline:2px solid var(--sp-accent);outline-offset:3px;}"
    },
    {
      "name": "Rail destination",
      "kind": "nav",
      "description": "Explicitly toggled desktop navigation; hover and keyboard focus do not widen the rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><button class=\"ds-nav-item\" aria-label=\"Workspace\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 4h16v12H9l-5 4V4Z\"/></svg></button></nav>",
      "css": ".ds-nav{width:64px;padding:12px 8px;background:var(--sp-bg);border-right:1px solid var(--sp-border)}.ds-nav-item{display:flex;align-items:center;justify-content:center;width:48px;min-height:48px;padding:8px;border:0;border-radius:8px;background:var(--sp-surface-raised);color:var(--sp-text);cursor:pointer}.ds-nav-item:hover{background:var(--sp-border)}.ds-nav-item:focus-visible{outline:2px solid var(--sp-accent);outline-offset:2px}"
    },
    {
      "name": "Trust label",
      "kind": "chip",
      "description": "Plain provenance text for a measured value.",
      "html": "<span class=\"ds-trust\">EXACT</span>",
      "css": ".ds-trust{font:500 12px/1.4 var(--sp-font-mono,Consolas,monospace);color:var(--sp-text-3);white-space:nowrap}"
    },
    {
      "name": "Divided settings section",
      "kind": "card",
      "description": "An open section rather than a floating dashboard card.",
      "html": "<section class=\"ds-section\"><h2>Appearance</h2><p>Choose the appearance for this device.</p></section>",
      "css": ".ds-section{padding:24px 0;border-bottom:1px solid var(--sp-border);color:var(--sp-text);font-family:var(--sp-font-sans,system-ui,sans-serif)}.ds-section h2{font-size:20px;line-height:1.4;font-weight:600;margin:0 0 10px}.ds-section p{font-size:14px;line-height:1.6;color:var(--sp-text-2);margin:0;max-width:65ch}"
    },
    {
      "name": "Agent reply",
      "kind": "custom",
      "description": "An open left-aligned reply on the conversation surface, with quiet metadata beneath.",
      "html": "<article class=\"ds-agent\"><p>The login flow is ready for review.</p><footer>Agent · 12:30</footer></article>",
      "css": ".ds-agent{max-width:800px;color:var(--sp-text);font:14px/1.7 var(--sp-font-sans,system-ui,sans-serif);overflow-wrap:anywhere}.ds-agent p{margin:0}.ds-agent footer{margin-top:8px;font-size:12px;text-align:right;color:var(--sp-text-2)}"
    },
    {
      "name": "User prompt",
      "kind": "custom",
      "description": "A neutral right-aligned prompt, with literal user text and a quiet border.",
      "html": "<div class=\"ds-user-row\"><article class=\"ds-user\"><p>Review authentication</p></article></div>",
      "css": ".ds-user-row{display:flex;justify-content:flex-end}.ds-user{max-width:100%;padding:12px 16px;background:var(--sp-surface-2);color:var(--sp-text);border:1px solid var(--sp-border);border-radius:16px;font:14px/1.7 var(--sp-font-sans,system-ui,sans-serif);overflow-wrap:anywhere}.ds-user p{margin:0;white-space:pre-wrap}",
      "refersTo": "user-prompt-dark"
    },
    {
      "name": "Composer Send",
      "kind": "button",
      "refersTo": "button-send-dark",
      "description": "The composer uses a theme-paired action, separate from red Stop or brand emphasis.",
      "html": "<button class=\"ds-send\">Send</button>",
      "css": ".ds-send{font:500 12px/1.4 var(--sp-font-sans,system-ui,sans-serif);min-height:32px;padding:6px 12px;background:var(--sp-cta-bg);color:var(--sp-cta-text);border:1px solid var(--sp-cta-bg);border-radius:999px;cursor:pointer}.ds-send:hover{background:var(--sp-cta-hover)}.ds-send:active{filter:brightness(.92)}.ds-send:focus-visible{outline:2px solid var(--sp-accent);outline-offset:2px}@media(max-width:899px){.ds-send{min-height:44px}}"
    },
    {
      "name": "Message composer",
      "kind": "custom",
      "refersTo": "composer-dark",
      "description": "A scrollable editor above a fixed action toolbar; focus changes only the outer 1px border, without an inner textarea rectangle.",
      "html": "<div class=\"ds-composer\" role=\"group\" aria-label=\"Message composer\"><div class=\"ds-composer-editor\"><textarea class=\"ds-composer-input\" aria-label=\"Message the agent\" rows=\"1\" placeholder=\"Message the agent...\"></textarea></div><div class=\"ds-composer-toolbar\"><select aria-label=\"Model\"><option>Agent default</option></select><button type=\"button\">Attach</button><button type=\"button\" class=\"ds-composer-send\">Send</button></div></div>",
      "css": ".ds-composer{display:flex;flex-direction:column;min-height:0;padding:12px;border:1px solid var(--sp-border-strong);border-radius:10px;background:var(--sp-surface-raised);color:var(--sp-text)}.ds-composer:focus-within{border-color:var(--sp-accent);box-shadow:none}.ds-composer-editor{display:flex;flex-direction:column;flex:1 1 auto;min-height:0;overflow:auto}.ds-composer-input{width:100%;min-height:48px;border:0;background:transparent;color:var(--sp-text);font:14px/1.7 var(--sp-font-sans,system-ui,sans-serif);resize:none}.ds-composer-input:focus{outline:none;box-shadow:none}.ds-composer-toolbar{display:flex;flex:none;gap:8px;align-items:center}.ds-composer-toolbar select,.ds-composer-toolbar button{min-height:32px;padding:6px 10px;border:0;border-radius:6px;background:transparent;color:var(--sp-text);font:500 12px/1.4 var(--sp-font-sans,system-ui,sans-serif)}.ds-composer-toolbar button:hover{background:var(--sp-border)}.ds-composer-toolbar :focus-visible{outline:2px solid var(--sp-accent);outline-offset:2px}.ds-composer-toolbar .ds-composer-send{margin-left:auto;background:var(--sp-cta-bg);color:var(--sp-cta-text);border-radius:999px}.ds-composer-toolbar .ds-composer-send:hover{background:var(--sp-cta-hover)}@media(max-width:899px){.ds-composer-input{font-size:16px}.ds-composer-toolbar select,.ds-composer-toolbar button{min-height:44px}}@media(max-width:899px) and (max-height:560px) and (min-width:600px){.ds-composer-editor{min-height:44px}.ds-composer-input{min-height:40px;max-height:64px}}"
    }
  ],
  "narrative": {
    "northStar": "Mission control",
    "overview": "Gnomcode keeps its lowercase wordmark, canonical solid triangle-and-square mark, red accent and near-black/light canvases. The interface is flat, precise and restrained: hairline divisions organize information; actions have modest corners and readable sans labels. The approved console redesign replaces the oversized branded hero and debug-style control rows with compact application chrome.\n\nMarketing keeps its established editorial scale and detaching navigation. Application surfaces prioritize task space, readable conversations and predictable controls. The accepted composition and verification boundaries live in the maintainer-local console surface brief; public product boundaries are recorded in [the product brief](docs/PRODUCT.md).",
    "keyCharacteristics": [
      "Canonical red accents and quiet neutral surfaces.",
      "Sans-led hierarchy with monospace reserved for data and commands.",
      "Restrained controls, open divided sections and geometric SVG icons.",
      "Compact application chrome with independently scrolling work areas."
    ],
    "rules": [
      {
        "name": "The Foreground Pair Rule",
        "body": "A control's foreground and background must switch theme together; never carry a light foreground onto a light fill or the reverse.",
        "section": "colors"
      },
      {
        "name": "The Task Before Chrome Rule",
        "body": "Application headings identify the current task; they do not repeat a marketing hero above it.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "Elevation communicates a floating interaction layer, not an extra decoration behind content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the canonical mark, shared palette and theme-specific foreground/background pairs.",
      "**Do** use restrained control corners, aligned action groups and visible keyboard focus.",
      "**Do** keep application chrome compact and make mobile conversation content fit its bubble.",
      "**Do** label unknown values and numeric trust accurately, preserving the Rust-owned reporting boundary.",
      "**Do** verify both themes, narrow layouts, open menus, dialogs and actual loading/error states."
    ],
    "donts": [
      "**Don't** use emojis, oversized pills, decorative gradients or color-only status indicators.",
      "**Don't** restore the oversized console hero, duplicate top navigation or debug-style action toolbar.",
      "**Don't** turn ordinary dashboard sections into nested floating cards.",
      "**Don't** substitute a display or monospace face for the user-approved system application typography.",
      "**Don't** infer release readiness, physical-device support or security certification from design captures."
    ]
  }
}
