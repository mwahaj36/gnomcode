  "narrative": {
    "northStar": "Mission control",
    "overview": "Spawnt keeps its lowercase wordmark, canonical solid triangle-and-square mark, red accent and near-black/light canvases. The interface is flat, precise and restrained: hairline divisions organize information; actions have modest corners and readable sans labels. The approved console redesign replaces the oversized branded hero and debug-style control rows with compact application chrome.\n\nMarketing keeps its established editorial scale and detaching navigation. Application surfaces prioritize task space, readable conversations and predictable controls. The accepted composition and verification boundaries live in [the console surface brief](docs/design/console-workspace.md); product and security behavior remain governed by [SPEC](docs/SPEC.md).",
    "keyCharacteristics": [
      "Canonical red accents and quiet neutral surfaces.",
      "Sans-led hierarchy with monospace reserved for data and commands.",
      "Restrained controls, open divided sections and geometric SVG icons.",
      "Compact application chrome with independently scrolling work areas."
    ],
    "rules": [
      {
        "name": "The Foreground Pair Rule",
        "body": "A control's foreground and background must switch theme together; never carry a light foreground onto a light fill or the reverse.",
        "section": "colors"
      },
      {
        "name": "The Task Before Chrome Rule",
        "body": "Application headings identify the current task; they do not repeat a marketing hero above it.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "Elevation communicates a floating interaction layer, not an extra decoration behind content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the canonical mark, shared palette and theme-specific foreground/background pairs.",
      "**Do** use restrained control corners, aligned action groups and visible keyboard focus.",
      "**Do** keep application chrome compact and make mobile conversation content fit its bubble.",
      "**Do** label unknown values and numeric trust accurately, preserving the Rust-owned reporting boundary.",
      "**Do** verify both themes, narrow layouts, open menus, dialogs and actual loading/error states."
    ],
    "donts": [
      "**Don't** use emojis, oversized pills, decorative gradients or color-only status indicators.",
      "**Don't** restore the oversized console hero, duplicate top navigation or debug-style action toolbar.",
      "**Don't** turn ordinary dashboard sections into nested floating cards.",
      "**Don't** use a font warning as a reason to replace the approved Inter family.",
      "**Don't** infer release readiness, physical-device support or security certification from design captures."
    ]
  }
}
