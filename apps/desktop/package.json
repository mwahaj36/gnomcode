{
  "name": "gnomcode-desktop",
  "private": true,
  "version": "1.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "lint": "eslint src",
    "package": "npm run build && electron-forge package",
    "package:win": "npm run make -- --platform win32 --arch x64",
    "make": "npm run build && electron-forge make",
    "prepackage": "node check-inputs.cjs",
    "premake": "node check-inputs.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "electron": "45.1.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "description": "Gnomcode local agent desktop",
  "author": "Wahaj",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
